{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nolane.local/habitat/schemas/coordination-notification.schema.json",
  "title": "Habitat Multi-Agent Coordination Notification",
  "type": "object",
  "required": ["id", "agent_id", "kind", "resource_kind", "resource_id", "revision", "status"],
  "properties": {
    "id": {"type": "string"},
    "agent_id": {"type": "string"},
    "kind": {"type": "string"},
    "resource_kind": {"type": "string"},
    "resource_id": {"type": "string"},
    "revision": {"type": "string"},
    "status": {"enum": ["pending", "acked"]},
    "caused_by_transaction": {"type": ["string", "null"]},
    "data": {"type": "object"}
  },
  "additionalProperties": true
}
