{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nolane.habitat/execution-receipt/v1alpha8-compatible",
  "type": "object",
  "required": [
    "id",
    "capability",
    "argv",
    "cwd",
    "timed_out",
    "duration_ms",
    "stdout",
    "stderr",
    "changed_paths"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^run:"
    },
    "capability": {
      "type": "string"
    },
    "argv": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cwd": {
      "type": "string"
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "timed_out": {
      "type": "boolean"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "stdout": {
      "type": "string"
    },
    "stderr": {
      "type": "string"
    },
    "stdout_truncated": {
      "type": "boolean"
    },
    "stderr_truncated": {
      "type": "boolean"
    },
    "changed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "structured": {
      "type": [
        "object",
        "null"
      ]
    },
    "backend_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "execution_backend": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_authority_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "execution_provider_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "stdout_total_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "stderr_total_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "environment_fingerprint": {
      "type": "object"
    },
    "redaction": {
      "type": "object"
    },
    "workspace_revision": {
      "type": "string",
      "minLength": 1
    }
  }
}
