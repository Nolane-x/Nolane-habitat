{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nolane.habitat/executive-trajectory/v1alpha14",
  "type": "object",
  "required": [
    "id",
    "goal",
    "status",
    "base_revision",
    "current_strategy",
    "strategy_generation",
    "milestones",
    "events",
    "trajectory_chain",
    "completion_gate",
    "claim_boundary",
    "phase_sequence",
    "budget_state"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "episode_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "active",
        "completed",
        "failed",
        "abandoned"
      ]
    },
    "base_revision": {
      "type": "string"
    },
    "current_revision": {
      "type": "string"
    },
    "current_strategy": {
      "enum": [
        "direct-analysis",
        "reframe",
        "causal-intervention",
        "rival-hypothesis",
        "external-oracle",
        "dependency-replan",
        "scope-reduction"
      ]
    },
    "strategy_generation": {
      "type": "integer",
      "minimum": 0
    },
    "budget": {
      "type": "object"
    },
    "metrics": {
      "type": "object"
    },
    "milestones": {
      "type": "array"
    },
    "events": {
      "type": "array"
    },
    "trajectory_chain": {
      "type": "object",
      "required": [
        "valid",
        "checked"
      ]
    },
    "completion_gate": {
      "type": "object",
      "required": [
        "ready",
        "blockers",
        "current_revision"
      ]
    },
    "claim_boundary": {
      "type": "string"
    },
    "phase_sequence": {
      "type": "object",
      "required": [
        "valid",
        "checked",
        "state"
      ]
    },
    "budget_state": {
      "type": "object",
      "required": [
        "limits",
        "consumed",
        "exhausted",
        "reasons",
        "strategy_switch_exhausted"
      ],
      "properties": {
        "limits": {
          "type": "object"
        },
        "consumed": {
          "type": "object",
          "properties": {
            "steps": {"type": "integer", "minimum": 0},
            "failed_steps": {"type": "integer", "minimum": 0},
            "strategy_switches": {"type": "integer", "minimum": 0},
            "wall_time_ms": {"type": ["integer", "null"], "minimum": 0},
            "tool_calls": {"type": "integer", "minimum": 0},
            "input_tokens": {"type": "integer", "minimum": 0},
            "output_tokens": {"type": "integer", "minimum": 0},
            "compute_ms": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": true
        },
        "accounting": {
          "type": "object",
          "properties": {
            "wall_time": {
              "enum": ["habitat-measured-host-wall-clock", "unavailable"]
            },
            "provider_usage": {
              "const": "provider-reported-hash-chained"
            },
            "provider_usage_required": {
              "type": "boolean"
            },
            "receipt_count": {
              "type": "integer",
              "minimum": 0
            },
            "invalid_receipt_count": {
              "type": "integer",
              "minimum": 0
            },
            "duplicate_receipt_count": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": true
        },
        "unmetered": {
          "type": "object"
        },
        "exhausted": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {"type": "string"}
        },
        "strategy_switch_exhausted": {
          "type": "boolean"
        },
        "claim_boundary": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
